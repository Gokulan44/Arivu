<?xml version="1.0" encoding="utf-8"?>
<!-- Deep dark-blue radial gradient used as a background layer behind screens. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="radial"
        android:gradientRadius="720dp"
        android:centerX="0.5"
        android:centerY="0.15"
        android:startColor="#1B2A4A"
        android:centerColor="#111827"
        android:endColor="#0A0F1E" />
</shape>
