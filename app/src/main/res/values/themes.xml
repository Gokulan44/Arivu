<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base app theme: dark Material 3, no action bar, SOC palette status bars. -->
    <style name="Theme.SOCAgent" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:statusBarColor">@color/soc_bg</item>
        <item name="android:navigationBarColor">@color/soc_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/soc_bg</item>

        <item name="colorPrimary">@color/soc_indigo</item>
        <item name="colorOnPrimary">@color/soc_text</item>
        <item name="colorSecondary">@color/soc_cyan</item>
        <item name="colorOnSecondary">@color/soc_bg</item>
        <item name="colorSurface">@color/soc_panel</item>
        <item name="colorOnSurface">@color/soc_text</item>
        <item name="colorSurfaceVariant">@color/soc_panel2</item>
        <item name="colorOnSurfaceVariant">@color/soc_muted</item>
        <item name="colorOutline">@color/soc_border</item>
        <item name="colorError">@color/soc_red</item>

        <item name="android:textColorPrimary">@color/soc_text</item>
        <item name="android:textColorSecondary">@color/soc_muted</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Dialog theme matching the SOC dark palette -->
    <style name="Theme.SOCAgent.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/soc_panel</item>
        <item name="colorOnSurface">@color/soc_text</item>
        <item name="colorPrimary">@color/soc_cyan</item>
        <item name="android:textColorPrimary">@color/soc_text</item>
        <item name="android:background">@color/soc_panel2</item>
    </style>
</resources>
