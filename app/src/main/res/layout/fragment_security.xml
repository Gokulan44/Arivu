<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/soc_bg"
    android:orientation="vertical">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_security"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/soc_panel"
        app:tabIndicatorColor="@color/soc_cyan"
        app:tabSelectedTextColor="@color/soc_cyan"
        app:tabTextColor="@color/soc_muted" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager_security"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>